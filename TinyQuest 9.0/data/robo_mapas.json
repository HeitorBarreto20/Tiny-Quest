{
  "_legenda": "# = parede, . = chão, R = posição inicial do robô, F = bandeira (chegada)",
  "facil": [
    ["###F", "....", ".###", "...R"],
    ["....", ".##.", ".#..", "R#F#"],
    ["...R", ".###", ".#F#", "...#"],
    ["R##F", ".#..", ".#.#", "...#"]
  ],
  "medio": [
    ["R#...", ".#.#.", "...#.", "####.", "F...."],
    ["....R", ".####", ".#F..", ".###.", "....."],
    [".....", ".###.", ".#...", ".#.##", "F#..R"],
    ["#####", "#...#", "#.#.#", "#.#.#", "R.#.F"]
  ],
  "dificil": [
    ["R#....", ".#.##.", "...##.", "#####.", "#...#.", "F.#..."],
    ["......", ".####.", ".#F##.", ".#..#.", ".##.#.", "....#R"],
    ["...#.R", ".#.#.#", ".#.#..", ".#.##.", ".#..#.", ".F#..."],
    ["#####F", "......", ".#####", "......", "#####.", "R....."]
  ]
}
